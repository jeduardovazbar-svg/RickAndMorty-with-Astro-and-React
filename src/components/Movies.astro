---
// Petición directa sin credenciales ni tokens
const response = await fetch("https://rickandmortyapi.com/api/character");
const data = await response.json();

const detail = "/detail/";
---

<div class="row">
  {
    /* Nota los paréntesis ( ) en lugar de llaves { } para que retorne el HTML */
    data.results.map((item) => (
      <div class="col-lg-3">
        <div class="card mt-4" style="width: 18rem;">
          <a href={detail + item.id}>
            <img 
              src={item.image} 
              class="card-img-top" 
              alt={item.name} 
            />
          </a>
          <div class="card-body">
            <h5 class="card-title">{item.name}</h5>
          </div>
        </div>
      </div>
    ))
  }
</div>